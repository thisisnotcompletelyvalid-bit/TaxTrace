# Local/default configuration. Docker Compose overrides DATABASE_URL for the API container.
DATABASE_URL=sqlite:///./taxtrace.db
APP_ENV=development
LOG_LEVEL=INFO
RAW_DATA_DIR=data/raw
WAREHOUSE_DATA_DIR=data/warehouse
HTTP_TIMEOUT_SECONDS=60
USER_AGENT=TaxTrace/0.1 (replace-with-a-contact-email-before-production)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
